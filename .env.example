# 复制成 .env 后按需修改
# cp .env.example .env

# HTTP 监听地址（默认 8081）
NETDISK_ADDR=:8081

# PostgreSQL（与 docker-compose.yml 里的端口对应）
NETDISK_DATABASE_URL=postgres://netdisk:netdisk@localhost:5433/netdisk?sslmode=disable

# JWT 签名密钥。生产环境必须换成长随机串：
#   openssl rand -hex 32
NETDISK_JWT_SECRET=dev-only-change-me
# token 有效期
NETDISK_JWT_TTL=24h

# 存储后端：local | s3
NETDISK_STORAGE_DRIVER=local
# local 后端的落盘目录
NETDISK_STORAGE_DIR=./data/blobs

# --- s3 后端（可选）---
# NETDISK_S3_ENDPOINT=localhost:9000
# NETDISK_S3_ACCESS_KEY=minioadmin
# NETDISK_S3_SECRET_KEY=minioadmin
# NETDISK_S3_BUCKET=netdisk
# NETDISK_S3_USE_SSL=false
